<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/iconGrayBackground"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Cover -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/novel_cover"
            android:layout_width="56dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/poster_descript"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="?attr/boxItemBackground" />

        <!-- Title -->
        <TextView
            android:id="@+id/novel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/textColor"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/novel_cover"
            app:layout_constraintEnd_toStartOf="@id/check_btn"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="The Eminence in Shadow" />

        <!-- Chapters state -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?attr/grayTextColor"
            app:layout_constraintStart_toEndOf="@id/novel_cover"
            app:layout_constraintEnd_toStartOf="@id/check_btn"
            app:layout_constraintTop_toBottomOf="@id/novel_title"
            tools:text="12 new chapters (362 total)" />

        <!-- new chapters badge -->
        <com.google.android.material.chip.Chip
            android:id="@+id/new_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:chipBackgroundColor="?attr/colorAccent"
            app:chipStrokeWidth="0dp"
            app:layout_constraintStart_toEndOf="@id/novel_cover"
            app:layout_constraintTop_toBottomOf="@id/status_text"
            tools:text="+12"
            tools:visibility="visible" />

        <!-- Chip "Mark as seen" -->
        <com.google.android.material.chip.Chip
            android:id="@+id/mark_seen_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:text="@string/updates_mark_seen"
            android:textColor="?attr/textColor"
            android:textSize="11sp"
            app:chipBackgroundColor="?attr/boxItemBackground"
            app:chipStrokeWidth="0dp"
            app:layout_constraintStart_toEndOf="@id/new_badge"
            app:layout_constraintTop_toBottomOf="@id/status_text"
            tools:visibility="visible" />

        <!-- sync / check button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/check_btn"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/updates_check_now"
            app:icon="@drawable/ic_baseline_autorenew_24"
            app:iconTint="?attr/colorAccent"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toStartOf="@id/remove_btn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Spinner -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/check_progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"
            android:indeterminate="true"
            app:indicatorSize="24dp"
            app:trackThickness="3dp"
            app:indicatorColor="?attr/colorAccent"
            app:layout_constraintEnd_toStartOf="@id/remove_btn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- delete button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/remove_btn"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/remove"
            app:icon="@drawable/ic_baseline_delete_outline_24"
            app:iconTint="@color/colorPrimaryRed"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>