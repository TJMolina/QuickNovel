<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/updates_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/primaryBlackBackground"
            android:paddingTop="@dimen/navbarHeight"
            app:menu="@menu/updates_actionbar"
            app:navigationIcon="@drawable/ic_baseline_arrow_back_24"
            app:navigationIconTint="?attr/iconColor"
            app:title="@string/updates_title"
            app:titleTextColor="?attr/textColor"
            app:layout_scrollFlags="scroll|enterAlways" />

    </com.google.android.material.appbar.AppBarLayout>



    <!-- skeleton loading -->
    <LinearLayout
        android:id="@+id/updates_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:visibility="visible">

        <include layout="@layout/loading_update_item" />
        <include layout="@layout/loading_update_item" />
        <include layout="@layout/loading_update_item" />
        <include layout="@layout/loading_update_item" />

    </LinearLayout>


    <!-- empty state -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp"
        tools:visibility="visible">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_baseline_autorenew_24"
            android:contentDescription="@string/updates_title"
            app:tint="?attr/grayTextColor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/updates_empty_title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="?attr/textColor"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/updates_empty_hint"
            android:textColor="?attr/grayTextColor"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- watching novels list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/updates_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_update_novel"
        tools:visibility="gone" />

    <!-- FAB: selection novels dialog -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_watch_novel"
        android:layout_margin="16dp"
        android:text="@string/updates_add_novels"
        app:icon="@drawable/ic_baseline_add_24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="56dp"
        android:contentDescription="@string/mainpage_sort_by_button_text"
        android:textColor="?attr/textColor"
        android:textStyle="bold"
        app:backgroundTint="?attr/primaryGrayBackground"
        app:elevation="4dp"
        app:iconTint="?attr/textColor"
        />

</androidx.coordinatorlayout.widget.CoordinatorLayout>